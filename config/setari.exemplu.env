# ===== SETARI JARVIS =====
# 1) Cheia Gemini (verifica limitele contului tau): intra pe https://aistudio.google.com/apikey
#    -> "Create API key" -> copiaz-o si pune-o dupa egal, fara spatii.
GEMINI_API_KEY=PUNE_CHEIA_AICI

# Modelul Gemini (lasa asa daca nu stii)
MODEL_GEMINI=gemini-flash-latest

# Cuvantul cu care il chemi
WAKE_WORD=jarvis

# da = raspunde la tot ce aude, fara sa spui "Jarvis" (nu recomand)
ASCULTA_MEREU=nu

# Cate secunde dupa un raspuns poti continua fara sa mai spui "Jarvis"
FEREASTRA_CONVERSATIE_SEC=12

# Limba in care vorbesti: ro sau en
LIMBA=ro

# Vocea (fisier din models\piper, fara .onnx)
VOCE=ro_RO-mihai-medium

# Optional: forteaza marimea Whisper (tiny, base, small, medium, large-v3). Gol = automat.
WHISPER_MODEL=
# Vocea online implicita; piper pentru sinteza locala
VOCE_MOTOR=edge
VOCE_EDGE=ro-RO-EmilNeural
VOCE_EDGE_EN=en-GB-RyanNeural
VOCE_VITEZA=+8%
VOCE_TON=-12Hz

# Gmail optional: completeaza doar in setari.env sau in panou
GMAIL_ADRESA=
GMAIL_PAROLA_APP=
